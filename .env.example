# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. (.env는 git에 커밋하지 마세요)

# Kakao Developers(https://developers.kakao.com) > 내 애플리케이션 > 앱 키 > REST API 키
# "로컬"(주소 검색)은 기본 활성화, "카카오모빌리티 길찾기"는 콘솔에서 별도 동의/활성화 필요.
KAKAO_REST_API_KEY=

# @BotFather 에게 /newbot 으로 봇을 만들면 발급되는 토큰
TELEGRAM_BOT_TOKEN=

# 봇과 대화를 한 번 연 뒤 https://api.telegram.org/bot<TOKEN>/getUpdates 에서 확인 가능한 내 chat id
TELEGRAM_CHAT_ID=
